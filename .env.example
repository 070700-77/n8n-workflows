# Copia este archivo a .env (en la raiz del repo, que en Docker es /scripts/.env)
# y rellena tus propios valores. NUNCA subas el .env real a GitHub.

# RapidAPI key — usada por wf_ejer_02 (Dummy Payment & Banking Data)
# y wf_ejer_04 (Currency Conversion & Exchange Rates).
# Creala en https://rapidapi.com/ y suscribete a ambas APIs.
X_RAPIDAPI_KEY=your_rapidapi_key_here

# URL base de TU propia API mock — usada por wf_ejer_03.
# Crea un proyecto en https://mockapi.io/ con un recurso de pagos y pega aqui su URL.
MOCKAPI_URL=https://YOUR_PROJECT_ID.mockapi.io/YOUR_RESOURCE
